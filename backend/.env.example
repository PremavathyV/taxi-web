# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# ── Admin Seed ────────────────────────────────────────────────
ADMIN_EMAIL=admin@sundaratravels.in
ADMIN_PASSWORD=Admin@1234

# ── Brevo Email API ───────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxx
SMTP_USER=your_gmail@gmail.com
MAIL_FROM="Sundara Travels <your_gmail@gmail.com>"
ADMIN_NOTIFY_EMAIL=admin@sundaratravels.in

# ── Frontend URL (for CORS) ───────────────────────────────────
CLIENT_URL=http://localhost:5000

# ── WhatsApp Notifications via CallMeBot (free) ──────────────
# Steps to get your API key:
#  1. Save +34 644 82 22 57 in WhatsApp contacts as "CallMeBot"
#  2. Send:  I allow callmebot to send me messages
#  3. You'll receive your CALLMEBOT_API_KEY in reply
CALLMEBOT_API_KEY=your_callmebot_api_key
OWNER_WHATSAPP_NUMBER=917639103970

